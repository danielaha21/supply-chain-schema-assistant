{
  "title": "Shipment Event",
  "type": "object",

  "properties": {
    "event_type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "object",
      "properties": {
        "facility_id": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" }
      },
      "required": [
        "facility_id",
        "city",
        "state",
        "country"
      ]
    },
    "shipment_id": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "units": {
      "type": "string"
    }
  },

  "required": [
    "event_type",
    "timestamp",
    "location",
    "shipment_id",
    "carrier",
    "quantity",
    "units"
  ]
}
